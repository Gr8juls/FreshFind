# Database (MongoDB Atlas / Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/freshfind?retryWrites=true&w=majority"
# For local development:
# MONGODB_URI="mongodb://localhost:27017/freshfind"

# Next.js Auth & JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Optional - AI Features (Google Gemini 2.0 / 1.5 Free Tier: https://aistudio.google.com/)
# If omitted, FreshFind automatically uses smart built-in heuristic AI engines with $0 cost!
GEMINI_API_KEY="your-google-gemini-api-key-here"

# Passwordless Email OTP (Resend)
RESEND_API_KEY="re_your-resend-api-key-here"

# Google OAuth 2.0 (Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Apple Sign-In (Optional - Apple Developer Portal)
APPLE_CLIENT_ID="your-apple-service-id"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"
APPLE_PRIVATE_KEY="your-apple-private-key-content"

# Optional - for maps/notifications/SMS
GOOGLE_MAPS_API_KEY="your-google-maps-key"
TWILIO_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"


